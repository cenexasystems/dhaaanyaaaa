# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon serverless Postgres — use the POOLED connection
# (the "-pooler" host on port 6543). The direct connection will not work
# with @neondatabase/serverless.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# POS login passcodes. There are NO built-in defaults — if these are missing,
# login is refused. Use long, unique values.
ADMIN_PASSCODE=change-me-to-a-long-random-admin-passcode
STAFF_PASSCODE=change-me-to-a-long-random-staff-passcode